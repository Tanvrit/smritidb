# Smritidb-specific
# Local SQLite DBs written by tests / examples. Production data lives outside
# the repo; anything matching this pattern in-tree is leftover from a run.
# (The cross-language conformance corpus and KMF fixtures under
# tests/conformance/ are intentionally tracked — they're contract data, not
# build artefacts.)
*.db
*.db-journal
*.db-wal
*.db-shm
!packages/*/test/**/*.db
!examples/**/fixtures/**/*.db

# Generated API documentation. The directory is regenerated by docs/regen.sh;
# the .gitkeep files below preserve the four sub-directory shells so the regen
# script has somewhere to write.
docs/api/*
!docs/api/.gitkeep
!docs/api/rust
!docs/api/python
!docs/api/kotlin
!docs/api/typescript
docs/api/rust/*
docs/api/python/*
docs/api/kotlin/*
docs/api/typescript/*
!docs/api/rust/.gitkeep
!docs/api/python/.gitkeep
!docs/api/kotlin/.gitkeep
!docs/api/typescript/.gitkeep

# Per-package LICENSE/NOTICE are copied from repo root at publish time
# (see packages/*/package.json prepublishOnly script)
packages/*/LICENSE
packages/*/NOTICE
