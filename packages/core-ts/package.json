{
  "name": "@tanvrit/smritidb",
  "version": "0.1.0",
  "description": "TypeScript reference implementation of Smritidb binary HDC associative memory.",
  "author": "Tanvrit Private Limited <ervivek40@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://tanvrit.com/smritidb",
  "bugs": {
    "url": "https://github.com/Tanvrit/smritidb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanvrit/smritidb.git",
    "directory": "packages/core-ts"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "default": "./dist/index.browser.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test 'src/**/*.test.ts'",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "cp ../../LICENSE LICENSE && cp ../../NOTICE NOTICE && pnpm test && pnpm build"
  },
  "keywords": [
    "hyperdimensional",
    "associative-memory",
    "vector-database",
    "binary-hdc",
    "kanerva"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "better-sqlite3": "^12.10.0",
    "tsx": "^4.19.0",
    "typedoc": "^0.28.19"
  }
}
